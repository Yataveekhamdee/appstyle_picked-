rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email in [
               'admin@stylepicked.com',
               'admin@gmail.com',
               'anucha.suks@gmail.com',
               'yatawikhadi@gmail.com'
             ];
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Products Collection - อนุญาตให้อ่านได้ทุกคน, เขียนต้องเป็น admin
    match /products/{productId} {
      allow read: if true;  // ทุกคนอ่านได้
      allow write: if isAdmin();  // เฉพาะ admin
    }
    
    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;  // ทุกคนอ่านได้
      allow write: if isAdmin();  // เฉพาะ admin
    }
    
    // Brands Collection  
    match /brands/{brandId} {
      allow read: if true;  // ทุกคนอ่านได้
      allow write: if isAdmin();  // เฉพาะ admin
    }
    
    // Admins Collection - เฉพาะ admin เท่านั้น
    match /admins/{adminId} {
      allow read: if isAdmin();  // เฉพาะ admin
      allow write: if isAdmin();  // เฉพาะ admin
    }
    
    // Users Collection - เฉพาะเจ้าของข้อมูล
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Cart subcollection
      match /cart/{cartItemId} {
        allow read, write: if isOwner(userId);
      }
      
      // Orders subcollection
      match /orders/{orderId} {
        allow read, write: if isOwner(userId);
      }
      
      // Addresses subcollection
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Orders Collection - admin อ่านได้, user อ่านเฉพาะของตัวเอง
    match /orders/{orderId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    // Reviews Collection - ทุกคนอ่านได้, เขียนต้องเข้าสู่ระบบ
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Analytics Collection - เฉพาะ admin
    match /analytics/{document} {
      allow read, write: if isAdmin();
    }
    
    // System Settings Collection - เฉพาะ admin
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Support Collection - admin และเจ้าของ ticket
    match /support/{ticketId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || 
                      (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Promotions Collection - ทุกคนอ่านได้, admin เขียนได้
    match /promotions/{promotionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Banners Collection - ทุกคนอ่านได้, admin เขียนได้
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Wishlist Collection - เฉพาะเจ้าของ
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Favorites Collection - เฉพาะเจ้าของ
    match /favorites/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Messages Collection - admin และเจ้าของ
    match /messages/{messageId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin() || 
                      (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // Default rule - ป้องกันการเข้าถึงที่ไม่ได้รับอนุญาต
    match /{document=**} {
      allow read, write: if false;
    }
  }
}





